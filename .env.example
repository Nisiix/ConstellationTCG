# ─── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in
# PGLITE_DATA_DIR. Set it to a real PostgreSQL / Supabase connection string to
# run against a server database.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# ─── TCGdex ──────────────────────────────────────────────────────────────────
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
TCGDEX_LANGUAGE=en
TCGDEX_CONCURRENCY=6

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Constellation
