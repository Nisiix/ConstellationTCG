# ─── Database ────────────────────────────────────────────────────────────────
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in
# PGLITE_DATA_DIR. Set it to a real PostgreSQL / Supabase connection string to
# run against a server database.
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite

# ─── TCGdex ──────────────────────────────────────────────────────────────────
TCGDEX_BASE_URL=https://api.tcgdex.net/v2
TCGDEX_LANGUAGE=en
TCGDEX_CONCURRENCY=6

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Constellation
# Public origin used in sign-in links (defaults to the request's origin).
NEXT_PUBLIC_SITE_URL=

# ─── Accounts (Supabase Auth, email links) ──────────────────────────────────
# My Constellation needs these; search and exploration work without them.
# The publishable key is safe to expose: row level security keeps private data private.
# Dedicated project "ConstellationTCG": https://supabase.com/dashboard/project/xtebcuuipklenukpsoyp
NEXT_PUBLIC_SUPABASE_URL=https://xtebcuuipklenukpsoyp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_9tOOzVh1u40QUwRnP7ztjg_mH05wRa9
# To serve the catalog from the same project (region eu-west-1, PostgreSQL 17), point DATABASE_URL
# at it. The pooler (port 6543, transaction mode) suits serverless hosts; the direct host suits a
# long-running server, ingestion and graph builds. The password is in the Supabase dashboard.
# DATABASE_URL=postgresql://postgres.xtebcuuipklenukpsoyp:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=postgresql://postgres:<password>@db.xtebcuuipklenukpsoyp.supabase.co:5432/postgres

# ─── Ownership providers (wallet sync) ──────────────────────────────────────
# EVM chains are read through public Blockscout instances (no key). Override a host if needed:
# BLOCKSCOUT_ETHEREUM_URL=https://eth.blockscout.com
# BLOCKSCOUT_POLYGON_URL=https://polygon.blockscout.com
# BLOCKSCOUT_BASE_URL=https://base.blockscout.com
# BLOCKSCOUT_ARBITRUM_URL=https://arbitrum.blockscout.com
# BLOCKSCOUT_OPTIMISM_URL=https://optimism.blockscout.com
# BLOCKSCOUT_GNOSIS_URL=https://gnosis.blockscout.com
# BLOCKSCOUT_ZKSYNC_URL=https://zksync.blockscout.com
# BLOCKSCOUT_SCROLL_URL=https://scroll.blockscout.com
# BLOCKSCOUT_LINEA_URL=https://explorer.linea.build
# BLOCKSCOUT_IMMUTABLE_URL=https://explorer.immutable.com
# Solana: with nothing set, the public mainnet RPC is used (no key; slower, rate limited). A
# DAS-capable endpoint (Helius, Triton, QuickNode, …) makes large wallets fast.
SOLANA_RPC_URL=
# SOLANA_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
