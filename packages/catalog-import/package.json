{
  "name": "@constellation/catalog-import",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The catalog import as a queue of small, resumable jobs (plan → one job per set → graph projection in steps), driven by a serverless worker or by the CLI.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@constellation/adapters": "workspace:*",
    "@constellation/database": "workspace:*",
    "@constellation/domain": "workspace:*",
    "@constellation/graph": "workspace:*",
    "@constellation/ingestion": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@constellation/adapter-pokemon": "workspace:*",
    "@constellation/testing": "workspace:*",
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
